[node name="AcceptDialog" type="AcceptDialog" parent="."]
title = "INSTRUCTIONS"
position = Vector2i(125, 190)
size = Vector2i(938, 314)
dialog_text = "
1) Choose your race
2) Set your stats. These are percentage based, so choosing 10 gives you 10% bonus. Choosing -10 gives you -10% penalty
3) Check any elemental immunities you want
4) Choose any special traits you want. Hold control and click on each one for multiple traits.
5) Click Generate to generate the mod
6) Click  Open Folder to open the folder the mods are generated to. Your mod should have the species name + Traits
7) Move that entire SpeciesTraits folder over to your Starbound mod folder.


"

